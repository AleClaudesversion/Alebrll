NODE_ENV=production
PORT=3001
DB_PATH=./data/mates.db

# Credenciales de Mercado Pago (developers.mercadopago.com.ar -> Tus integraciones -> Credenciales de produccion)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret (panel de MP -> Notificaciones webhook -> "Firma secreta")
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# URL publica donde queda servido el sitio (sin barra final), usada para armar back_urls y notification_url
PUBLIC_BASE_URL=https://jaquemate.mymatedigital.com

# Numero de WhatsApp del negocio (formato internacional sin +, ej. 5491122334455)
WHATSAPP_NUMBER=5490000000000
