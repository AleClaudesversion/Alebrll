{
  "name": "ja-que-mate",
  "version": "1.0.0",
  "description": "Ecommerce de ¡Ja que mate! - mates, bombillas, termos y accesorios",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:render": "node scripts/seed.js && node src/server.js",
